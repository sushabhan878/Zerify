{
  "compilerOptions": {
    "target": "es2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "typeRoots": [
      "../node_modules/@types",
      "../apps/backend/node_modules/@types"
    ],
    "types": ["jest", "node"]
  },
  "include": ["**/*"]
}
