// Prisma Schema for Zerify — Neon PostgreSQL
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  BRAND
  INFLUENCER
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  neonAuthId    String?        @unique
  role          UserRole       @default(BRAND)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  brandProfile  BrandProfile?
  influencer    InfluencerProfile?

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizations")
}

model BrandProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  website     String?
  logoUrl     String?  // Cloudinary image URL
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("brand_profiles")
}

model InfluencerProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  handle      String
  platform    String
  avatarUrl   String?  // Cloudinary image URL
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("influencer_profiles")
}
