// Prisma Schema for Zerify — Neon PostgreSQL
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  BRAND
  INFLUENCER
}

model User {
  id            String             @id @default(uuid())
  email         String             @unique
  name          String?
  password      String?
  neonAuthId    String?            @unique
  role          UserRole           @default(BRAND)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  brandProfile  BrandProfile?
  influencer    InfluencerProfile?

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizations")
}

model BrandProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String?
  website     String?
  logoUrl     String?  // Cloudinary image URL
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("brand_profiles")
}

model InfluencerProfile {
  id                      String                        @id @default(uuid())
  userId                  String                        @unique
  user                    User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Basic Information
  handle                  String?
  bio                     String?
  location                String?
  phoneCode               String?                       @default("+1")
  phoneNumber             String?
  dob                     DateTime?
  gender                  String?
  
  // Niche & Language Attributes (niches stores categories/niches)
  niches                  String[]                      @default([])
  contentLanguages        String[]                      @default([])
  
  // Collaboration Preferences & Pricing
  availableForBarter      Boolean                       @default(false)
  availableForRelocation  Boolean                       @default(false)
  collaborationTypes      String[]                      @default([])
  minPricePerReel         Float?
  currency                String?                       @default("USD")
  responseTime            String?                       @default("Within 24 hours")
  
  avatarUrl               String?
  pricingRange            String?

  // Connected Accounts, Deliverables & Payment Relations
  connectedAccounts       InfluencerConnectedAccount[]
  pastDeliverables        InfluencerPastDeliverable[]
  paymentDetails          InfluencerPaymentDetails?

  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt

  @@map("influencer_profiles")
}

model InfluencerConnectedAccount {
  id             String            @id @default(uuid())
  influencerId   String
  influencer     InfluencerProfile @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  platform       String            // e.g. "Instagram", "YouTube", "TikTok"
  handle         String?
  followerCount  Int?              @default(0)
  engagementRate Float?
  profileUrl     String?
  isVerified     Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@map("influencer_connected_accounts")
}

model InfluencerPastDeliverable {
  id           String            @id @default(uuid())
  influencerId String
  influencer   InfluencerProfile @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  title        String?
  brandName    String?
  contentUrl   String
  contentType  String?           // e.g. "Reel", "Video", "Post"
  thumbnailUrl String?
  viewsCount   Int?              @default(0)
  likesCount   Int?              @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("influencer_past_deliverables")
}

model InfluencerPaymentDetails {
  id            String            @id @default(uuid())
  influencerId  String            @unique
  influencer    InfluencerProfile @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  payoutMethod  String?           @default("Cashfree")
  accountHolder String?
  accountNumber String?
  ifscCode      String?
  upiId         String?
  paypalEmail   String?
  gstin         String?
  panNumber     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("influencer_payment_details")
}

enum VipType {
  BRAND
  INFLUENCER
}

model VipAccess {
  id        String   @id @default(uuid())
  email     String   @unique
  type      VipType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vip_access")
}
