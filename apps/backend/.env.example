# Neon PostgreSQL Connection String
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-123456.us-east-2.aws.neon.tech/zerify?sslmode=require"

PORT=4000
NODE_ENV="development"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Redis
REDIS_URL="redis://localhost:6379"

# Neon Auth / JWT
NEON_AUTH_DOMAIN="https://your-neon-auth.neon.tech"
JWT_SECRET="zerify-dev-secret-key"


# Meta / Facebook & Instagram Integration
META_APP_ID="your_meta_app_id_here"
META_APP_SECRET="your_meta_app_secret_here"
META_REDIRECT_URI="http://localhost:4000/api/v1/social/meta/callback"
SOCIAL_ENCRYPTION_SECRET="a-strong-random-32-byte-secret"