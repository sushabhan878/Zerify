{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zerify demo scene manifest",
  "type": "object",
  "required": ["scenes"],
  "properties": {
    "headline": {"type": "string"},
    "accent": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "fps": {"type": "number", "minimum": 1},
    "scenes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "file", "title", "seconds"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "file": {"type": "string", "description": "PNG filename stem under assets/captures"},
          "title": {"type": "string", "maxLength": 80},
          "subtitle": {"type": "string", "maxLength": 100},
          "note": {"type": "string", "description": "Replaces subtitle when provided"},
          "seconds": {"type": "number", "minimum": 1},
          "cropTop": {"type": "number", "minimum": 0, "description": "Raw screenshot pixels, typically80 to remove browser chrome"},
          "cropBottom": {"type": "number", "minimum": 0},
          "cleanCursor": {"type": "boolean", "description": "Enable animated cursor only when baked native cursor was parked in the cropped region"},
          "focus": {
            "type": "object",
            "properties": {
              "x": {"type": "number", "minimum": 0, "maximum": 1},
              "y": {"type": "number", "minimum": 0, "maximum": 1},
              "scale": {"type": "number", "minimum": 1, "maximum": 3},
              "at": {"type": "number", "minimum": 0},
              "hold": {"type": "boolean"}
            }
          },
          "clicks": {
            "type": "array", "items": {
              "type": "object", "required": ["x", "y"],
              "properties": {
                "at": {"type": "number", "description": "Seconds relative to this scene"},
                "x": {"type": "number", "description": "X in raw screenshot pixels"},
                "y": {"type": "number", "description": "Y in raw screenshot pixels"}
              }
            }
          }
        }
      }
    }
  }
}
